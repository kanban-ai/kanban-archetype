# ────────────────────────────────────────────────────────────────────────────
# Site / SEO
# ────────────────────────────────────────────────────────────────────────────

# URL pública canônica do site (sem barra final). Usada em metadata, OG,
# sitemap e robots. Em produção aponte para o domínio final (https://...).
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Nome da marca exibido em SEO/JSON-LD/Footer.
NEXT_PUBLIC_SITE_NAME="Acme Inc."

# Locale padrão usado em <html lang> e OpenGraph (ex.: pt_BR, en_US).
NEXT_PUBLIC_DEFAULT_LOCALE=pt_BR

# Token de verificação do Google Search Console (opcional).
# Cole apenas o valor (sem aspas, sem prefixo "google-site-verification=").
GOOGLE_SITE_VERIFICATION=

# ────────────────────────────────────────────────────────────────────────────
# Analytics — preencha em produção, deixe vazio em dev/preview
# ────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX).
# Quando vazio, o gtag.js NÃO é carregado (zero JS extra em dev).
# Onde encontrar: Admin → Property → Data Streams → Web → Measurement ID.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager — Container ID (formato GTM-XXXXXXX).
# Quando vazio, o GTM NÃO é injetado.
# Use GTM em vez do GA direto se você precisa orquestrar múltiplas tags
# (Meta Pixel, hotjar, ads, etc.) sem redeploy.
NEXT_PUBLIC_GTM_ID=
