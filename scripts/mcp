#!/usr/bin/env node

/**
 * MCP App Manager - Gerenciador de aplicação via MCP
 *
 * Subcomandos:
 * - app: Gerencia aplicação (action: start/stop)
 * - migration: Executa migrations do backend (action: run/revert/show)
 */

const { spawn, exec } = require('child_process');
const { promisify } = require('util');
const path = require('path');
const fs = require('fs').promises;
const readline = require('readline');

const execAsync = promisify(exec);

// Diretórios
const ROOT_DIR = path.resolve(__dirname, '..');
const BACK_DIR = path.join(ROOT_DIR, 'backend');
const FRONT_DIR = path.join(ROOT_DIR, 'frontend');
const LOGS_DIR = path.join(ROOT_DIR, 'logs');

/**
 * Helper para executar comandos com configuração adequada de shell e PATH
 */
function safeExecAsync(command, options = {}) {
  return execAsync(command, {
    shell: '/bin/bash',
    env: {
      ...process.env,
      PATH: process.env.PATH || '/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin'
    },
    ...options
  });
}

/**
 * Aguarda uma porta ficar disponível (servidor iniciado)
 */
async function waitForPort(port, maxAttempts = 60, interval = 1000) {
  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      // Tentar fazer uma requisição HTTP simples
      const http = require('http');
      await new Promise((resolve, reject) => {
        const req = http.get(`http://localhost:${port}`, (res) => {
          resolve(true);
        });
        req.on('error', (err) => {
          reject(err);
        });
        req.setTimeout(500);
        req.end();
      });

      // Se chegou aqui, a porta está respondendo
      return true;
    } catch (error) {
      // Porta ainda não está disponível, aguardar
      if (attempt < maxAttempts) {
        await new Promise(resolve => setTimeout(resolve, interval));
      }
    }
  }

  throw new Error(`Timeout: Servidor não iniciou na porta ${port} após ${maxAttempts} tentativas`);
}

/**
 * Inicia a aplicação (backend e frontend)
 */
async function startApp() {
  try {
    // Criar diretório de logs se não existir
    await fs.mkdir(LOGS_DIR, { recursive: true });

    const backLogPath = path.join(LOGS_DIR, 'back.log');
    const frontLogPath = path.join(LOGS_DIR, 'front.log');

    // Iniciar backend
    const { stdout: backPid } = await safeExecAsync(
      `NO_COLOR=1 nohup npm run start:dev > "${backLogPath}" 2>&1 & echo $!`,
      { cwd: BACK_DIR }
    );

    const backPidClean = backPid.trim();
    await fs.writeFile(path.join(LOGS_DIR, 'back.pid'), backPidClean);

    // Aguardar backend subir na porta 3000
    await waitForPort(3000);

    // Iniciar frontend
    const { stdout: frontPid } = await safeExecAsync(
      `nohup npm run dev > "${frontLogPath}" 2>&1 & echo $!`,
      { cwd: FRONT_DIR }
    );

    const frontPidClean = frontPid.trim();
    await fs.writeFile(path.join(LOGS_DIR, 'front.pid'), frontPidClean);

    return {
      success: true,
      message: 'Aplicação iniciada com sucesso',
      details: {
        backend: {
          pid: parseInt(backPidClean),
          port: 3000,
          log: backLogPath,
          status: 'running'
        },
        frontend: {
          pid: parseInt(frontPidClean),
          port: 5173,
          log: frontLogPath
        }
      }
    };
  } catch (error) {
    return {
      success: false,
      error: error.message
    };
  }
}

/**
 * Inicia os serviços Docker (PostgreSQL, Redis, etc)
 */
async function startServices() {
  try {
    const dockerComposePath = path.join(ROOT_DIR, 'scripts', 'docker-compose.yml');

    const { stdout, stderr } = await safeExecAsync(
      `docker compose -f "${dockerComposePath}" up -d`
    );

    return {
      success: true,
      message: 'Serviços Docker iniciados com sucesso',
      output: stdout,
      errors: stderr
    };
  } catch (error) {
    return {
      success: false,
      error: error.message,
      output: error.stdout || '',
      errors: error.stderr || ''
    };
  }
}

/**
 * Para a aplicação
 */
async function stopApp() {
  try {
    const results = [];

    // Parar usando PIDs salvos
    for (const service of ['back', 'front']) {
      try {
        const pidPath = path.join(LOGS_DIR, `${service}.pid`);
        const pid = await fs.readFile(pidPath, 'utf-8');
        await safeExecAsync(`kill -9 ${pid.trim()}`);
        results.push(`${service}: PID ${pid.trim()} finalizado`);
      } catch (error) {
        results.push(`${service}: não encontrado ou já finalizado`);
      }
    }

    // Limpar processos do projeto como fallback
    try {
      await safeExecAsync("pkill -9 -f 'micro-saas.*node_modules'");
      results.push('Processos do projeto finalizados');
    } catch (error) {
      // Ignorar se não houver processos
    }

    // Matar processos nas portas como fallback
    for (const port of [3000, 5173]) {
      try {
        const { stdout } = await safeExecAsync(`lsof -ti:${port}`);
        if (stdout.trim()) {
          await safeExecAsync(`kill -9 ${stdout.trim()}`);
          results.push(`Porta ${port} liberada`);
        }
      } catch (error) {
        // Ignorar se porta não estiver em uso
      }
    }

    return {
      success: true,
      message: 'Aplicação parada com sucesso',
      details: results
    };
  } catch (error) {
    return {
      success: false,
      error: error.message
    };
  }
}

/**
 * Executa migration do backend
 */
async function runMigration(action) {
  if (!['run', 'revert', 'show'].includes(action)) {
    return {
      success: false,
      error: 'Ação inválida. Use "run", "revert" ou "show"'
    };
  }

  // Verificar se a pasta backend existe
  const fsSync = require('fs');
  if (!fsSync.existsSync(BACK_DIR)) {
    return {
      success: false,
      error: `Pasta backend não encontrada: ${BACK_DIR}`
    };
  }

  // Verificar se package.json existe
  const packageJsonPath = path.join(BACK_DIR, 'package.json');
  if (!fsSync.existsSync(packageJsonPath)) {
    return {
      success: false,
      error: `package.json não encontrado em: ${BACK_DIR}`
    };
  }

  try {
    const { stdout, stderr } = await safeExecAsync(`npm run migration:${action}`, {
      cwd: BACK_DIR
    });

    return {
      success: true,
      message: `Migration ${action} executada com sucesso`,
      output: stdout,
      errors: stderr
    };
  } catch (error) {
    return {
      success: false,
      error: error.message,
      output: error.stdout || '',
      errors: error.stderr || ''
    };
  }
}

/**
 * Obtém informações sobre o status da aplicação
 */
async function getAppStatus() {
  const status = {
    backend: { running: false, pid: null, port: 3000 },
    frontend: { running: false, pid: null, port: 5173 },
    docker: { running: false }
  };

  // Verificar backend
  try {
    const backPidPath = path.join(LOGS_DIR, 'back.pid');
    const backPid = await fs.readFile(backPidPath, 'utf-8');
    await safeExecAsync(`kill -0 ${backPid.trim()}`);
    status.backend.running = true;
    status.backend.pid = parseInt(backPid.trim());
  } catch (error) {
    // Processo não está rodando
  }

  // Verificar frontend
  try {
    const frontPidPath = path.join(LOGS_DIR, 'front.pid');
    const frontPid = await fs.readFile(frontPidPath, 'utf-8');
    await safeExecAsync(`kill -0 ${frontPid.trim()}`);
    status.frontend.running = true;
    status.frontend.pid = parseInt(frontPid.trim());
  } catch (error) {
    // Processo não está rodando
  }

  // Verificar Docker
  try {
    const { stdout } = await safeExecAsync('docker compose ps', { cwd: BACK_DIR });
    status.docker.running = stdout.includes('postgres-development');
  } catch (error) {
    // Docker não está rodando
  }

  return status;
}

/**
 * Lê os últimos N bytes de um arquivo de log
 */
async function readLogTail(logFile, bytes = 5000) {
  try {
    const logPath = path.join(LOGS_DIR, logFile);
    const stats = await fs.stat(logPath);
    const size = stats.size;

    if (size === 0) {
      return '(log vazio)';
    }

    const file = await fs.open(logPath, 'r');
    const buffer = Buffer.alloc(Math.min(bytes, size));
    const readBytes = Math.min(bytes, size);
    await file.read(buffer, 0, readBytes, Math.max(0, size - readBytes));
    await file.close();

    return buffer.toString('utf-8');
  } catch (error) {
    return `Erro ao ler log: ${error.message}`;
  }
}

/**
 * Servidor MCP
 */
async function startMCPServer(subcommand) {
  const tools = {
    'app': [{
      name: 'manage_application',
      description: 'Gerencia a aplicação SDD (backend NestJS na porta 3000 e frontend Vite/React na porta 5173). Use action="start" para iniciar aplicação completa, action="stop" para parar todos os processos, ou action="docker-compose-up" para subir apenas os containers Docker (PostgreSQL, Redis) sem iniciar a aplicação Node.js.',
      inputSchema: {
        type: 'object',
        properties: {
          action: {
            type: 'string',
            enum: ['start', 'stop', 'docker-compose-up'],
            description: 'Ação a executar: "start" para iniciar aplicação (backend + frontend), "stop" para parar todos os processos, "docker-compose-up" para executar docker compose up -d (sobe PostgreSQL, Redis e outros containers definidos no docker-compose.yml)'
          }
        },
        required: ['action']
      }
    }],
    'migration': [{
      name: 'run_migration',
      description: 'Executa migrations TypeORM do backend NestJS. Use action="run" para aplicar novas migrations, action="revert" para reverter a última migration aplicada, ou action="show" para listar migrations pendentes.',
      inputSchema: {
        type: 'object',
        properties: {
          action: {
            type: 'string',
            enum: ['run', 'revert', 'show'],
            description: 'Ação a executar: "run" para aplicar migrations, "revert" para reverter a última migration, "show" para listar migrations pendentes'
          }
        },
        required: ['action']
      }
    }]
  };

  const resources = {
    'app': [
      {
        uri: 'app://status',
        name: 'Application Status',
        description: 'Status atual da aplicação (backend, frontend, docker)',
        mimeType: 'application/json'
      },
      {
        uri: 'app://logs/backend',
        name: 'Backend Logs',
        description: 'Últimas linhas do log do backend',
        mimeType: 'text/plain'
      },
      {
        uri: 'app://logs/frontend',
        name: 'Frontend Logs',
        description: 'Últimas linhas do log do frontend',
        mimeType: 'text/plain'
      }
    ],
    'migration': [
      {
        uri: 'app://status',
        name: 'Application Status',
        description: 'Status atual da aplicação (backend, frontend, docker)',
        mimeType: 'application/json'
      }
    ]
  };

  async function handleToolCall(name, args) {
    switch (name) {
      case 'manage_application':
        if (args.action === 'start') {
          return await startApp();
        } else if (args.action === 'stop') {
          return await stopApp();
        } else if (args.action === 'docker-compose-up') {
          return await startServices();
        } else {
          throw new Error(`Ação inválida: ${args.action}`);
        }
      case 'run_migration':
        return await runMigration(args.action);
      default:
        throw new Error(`Ferramenta desconhecida: ${name}`);
    }
  }

  async function handleResourceRead(uri) {
    switch (uri) {
      case 'app://status':
        const status = await getAppStatus();
        return {
          uri,
          mimeType: 'application/json',
          text: JSON.stringify(status, null, 2)
        };
      case 'app://logs/backend':
        const backLog = await readLogTail('back.log');
        return {
          uri,
          mimeType: 'text/plain',
          text: backLog
        };
      case 'app://logs/frontend':
        const frontLog = await readLogTail('front.log');
        return {
          uri,
          mimeType: 'text/plain',
          text: frontLog
        };
      default:
        throw new Error(`Resource não encontrado: ${uri}`);
    }
  }

  async function handleMessage(message) {
    const { method, params, id } = message;

    try {
      if (method === 'initialize') {
        return {
          jsonrpc: '2.0',
          id,
          result: {
            protocolVersion: '2024-11-05',
            serverInfo: {
              name: `mcp-${subcommand}`,
              version: '1.0.0'
            },
            capabilities: {
              tools: {},
              resources: {}
            }
          }
        };
      }

      if (method === 'notifications/initialized') {
        // Notification - não precisa de resposta
        console.error(`✓ Cliente confirmou inicialização (mcp-${subcommand})`);
        return null;
      }

      if (method === 'tools/list') {
        return {
          jsonrpc: '2.0',
          id,
          result: {
            tools: tools[subcommand] || []
          }
        };
      }

      if (method === 'tools/call') {
        const { name, arguments: args } = params;
        const result = await handleToolCall(name, args);

        return {
          jsonrpc: '2.0',
          id,
          result: {
            content: [
              {
                type: 'text',
                text: JSON.stringify(result, null, 2)
              }
            ]
          }
        };
      }

      if (method === 'resources/list') {
        return {
          jsonrpc: '2.0',
          id,
          result: {
            resources: resources[subcommand] || []
          }
        };
      }

      if (method === 'resources/read') {
        const { uri } = params;
        const resource = await handleResourceRead(uri);

        return {
          jsonrpc: '2.0',
          id,
          result: {
            contents: [resource]
          }
        };
      }

      throw new Error(`Método não suportado: ${method}`);
    } catch (error) {
      return {
        jsonrpc: '2.0',
        id,
        error: {
          code: -32603,
          message: error.message
        }
      };
    }
  }

  // Log inicial para stderr (não interfere com o protocolo MCP)
  console.error(`MCP App Manager (${subcommand}) iniciado`);

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: false
  });

  rl.on('line', async (line) => {
    try {
      const message = JSON.parse(line);
      const response = await handleMessage(message);
      // Só envia resposta se não for null (notifications não têm resposta)
      if (response !== null) {
        console.log(JSON.stringify(response));
      }
    } catch (error) {
      console.log(JSON.stringify({
        jsonrpc: '2.0',
        id: null,
        error: {
          code: -32700,
          message: `Parse error: ${error.message}`
        }
      }));
    }
  });

  rl.on('close', () => {
    console.error(`MCP Server (${subcommand}) encerrado`);
    process.exit(0);
  });
}

/**
 * Main
 */
async function main() {
  const subcommand = process.argv[2];

  if (!subcommand || !['app', 'migration'].includes(subcommand)) {
    console.error('Uso: scripts/mcp <app|migration>');
    process.exit(1);
  }

  await startMCPServer(subcommand);
}

main();
