#!/usr/bin/env node

const fs = require('fs');
const path = require('path');

// Carregar configurações de .env.local se existir
const envLocalPath = path.join(__dirname, '..', '.env.local');
if (fs.existsSync(envLocalPath)) {
  const envContent = fs.readFileSync(envLocalPath, 'utf-8');
  envContent.split('\n').forEach(line => {
    const match = line.match(/^([^=]+)=(.*)$/);
    if (match && !process.env[match[1]]) {
      process.env[match[1]] = match[2];
    }
  });
}

// Configurações
const CHROMA_HOST = process.env.CHROMA_HOST || 'http://localhost:8000';
const OPENAI_API_KEY = process.env.OPENAI_API_KEY;
const TENANT = 'default_tenant';
const DATABASE = 'default_database';
const COLLECTION_NAME = 'rules_documentation';
const RULES_DIR = path.join(__dirname, '..', '.rules');
const API_BASE = `/api/v2/tenants/${TENANT}/databases/${DATABASE}`;

// Cores para output
const colors = {
  reset: '\x1b[0m',
  red: '\x1b[0;31m',
  green: '\x1b[0;32m',
  yellow: '\x1b[1;33m',
  blue: '\x1b[0;34m',
  cyan: '\x1b[0;36m'
};

function log(message, color = 'reset') {
  console.log(`${colors[color]}${message}${colors.reset}`);
}

// Função para gerar embedding via OpenAI API
async function generateEmbedding(text) {
  const response = await fetch('https://api.openai.com/v1/embeddings', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${OPENAI_API_KEY}`
    },
    body: JSON.stringify({
      model: 'text-embedding-ada-002',
      input: text
    })
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`OpenAI API error: ${response.status} - ${error}`);
  }

  const data = await response.json();
  return data.data[0].embedding;
}

// Função para validar tamanho do texto
function validateTextSize(text, metadata, maxTokens = 8000) {
  // Estimativa: ~4 caracteres por token em português
  const maxChars = maxTokens * 4;

  if (text.length <= maxChars) {
    return { valid: true };
  }

  // Texto excede o limite - retornar erro detalhado
  return {
    valid: false,
    size: text.length,
    maxSize: maxChars,
    exceeded: text.length - maxChars,
    metadata
  };
}

// Função para gerar embeddings em lote via OpenAI API
async function generateEmbeddingsBatch(texts, batchSize = 100) {
  const embeddings = [];
  const totalBatches = Math.ceil(texts.length / batchSize);

  for (let i = 0; i < texts.length; i += batchSize) {
    const batch = texts.slice(i, i + batchSize);
    const batchNum = Math.floor(i / batchSize) + 1;

    // Mostrar progresso apenas se houver múltiplos lotes
    if (totalBatches > 1) {
      log(`  Processando lote ${batchNum}/${totalBatches}...`, 'blue');
    }

    const response = await fetch('https://api.openai.com/v1/embeddings', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${OPENAI_API_KEY}`
      },
      body: JSON.stringify({
        model: 'text-embedding-ada-002',
        input: batch
      })
    });

    if (!response.ok) {
      const error = await response.text();
      log(`✗ Erro ao gerar embeddings: ${error}`, 'red');
      throw new Error('Falha ao gerar embeddings');
    }

    const data = await response.json();
    embeddings.push(...data.data.map(item => item.embedding));
  }

  return embeddings;
}

// Função para fazer requisições HTTP usando fetch nativo
async function chromaFetch(endpoint, options = {}) {
  const url = `${CHROMA_HOST}${endpoint}`;
  try {
    const response = await fetch(url, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        ...options.headers
      }
    });

    const text = await response.text();
    const data = text ? JSON.parse(text) : null;

    return { ok: response.ok, status: response.status, data };
  } catch (error) {
    throw new Error(`Erro na requisição: ${error.message}`);
  }
}

// Função para obter ID da coleção
async function getCollectionId() {
  const { data: collections } = await chromaFetch(`${API_BASE}/collections`);
  const collection = collections?.find(c => c.name === COLLECTION_NAME);
  return collection?.id;
}

// Função para criar ou obter coleção existente
async function getOrCreateCollection() {
  log('Verificando coleção "rules_documentation"...', 'yellow');

  // Tentar obter coleção existente
  let collectionId = await getCollectionId();

  if (collectionId) {
    log('✓ Coleção já existe, será atualizada.', 'green');
    return collectionId;
  }

  // Criar nova coleção se não existir
  log('Criando nova coleção...', 'yellow');
  const { ok, data } = await chromaFetch(`${API_BASE}/collections`, {
    method: 'POST',
    body: JSON.stringify({
      name: COLLECTION_NAME,
      metadata: { description: 'Documentação de regras do projeto SDD' }
    })
  });

  if (ok) {
    log('✓ Coleção criada com sucesso.', 'green');
    return data.id;
  } else {
    throw new Error(`Erro ao criar coleção: ${JSON.stringify(data)}`);
  }
}


// Função para extrair blocos de um arquivo markdown
function extractBlocks(content, filename, filepath) {
  const lines = content.split('\n');
  const blocks = [];

  let currentBlock = '';
  let currentHeader = '';
  let currentTitle = ''; // Rastrear título de nível #
  let startLine = 1;
  let blockCount = 0;

  // Regex para capturar títulos de nível 1: # [texto]()
  const titleRegex = /^#\s+\[(.+?)\]\(\)/;
  // Regex para capturar títulos de nível 2: ## [texto]()
  const headerRegex = /^##\s+\[(.+?)\]\(\)/;

  for (let lineNum = 1; lineNum <= lines.length; lineNum++) {
    const line = lines[lineNum - 1];

    // Verificar se linha é um título # [texto]()
    const titleMatch = line.match(titleRegex);
    if (titleMatch) {
      currentTitle = `# ${titleMatch[1]}`;
    }

    // Verificar se linha é um título ## [texto]()
    const headerMatch = line.match(headerRegex);

    if (headerMatch) {
      // Se já temos um bloco, salvar
      if (currentBlock) {
        blocks.push({
          id: `${filename}:block:${blockCount}`.replace(/[^a-zA-Z0-9:._-]/g, '_'),
          document: currentBlock,
          metadata: {
            type: 'block',
            filename,
            filepath,
            start_line: startLine,
            end_line: lineNum - 1,
            title: currentTitle,
            header: currentHeader
          }
        });
        blockCount++;
      }

      // Iniciar novo bloco
      const headerTitle = headerMatch[1];
      currentHeader = `## ${headerTitle}`;
      currentBlock = line;
      startLine = lineNum;
    } else {
      // Adicionar linha ao bloco atual
      if (currentBlock) {
        currentBlock += '\n' + line;
      } else {
        // Primeira linha do arquivo não é header semântico
        if (!currentHeader) {
          currentHeader = '(início do arquivo)';
          currentBlock = line;
          startLine = lineNum;
        }
      }
    }
  }

  // Salvar último bloco
  if (currentBlock) {
    blocks.push({
      id: `${filename}:block:${blockCount}`.replace(/[^a-zA-Z0-9:._-]/g, '_'),
      document: currentBlock,
      metadata: {
        type: 'block',
        filename,
        filepath,
        start_line: startLine,
        end_line: lines.length,
        title: currentTitle,
        header: currentHeader
      }
    });
  }

  return blocks;
}

// Função para indexar documentos
async function indexDocuments() {
  log('Indexando documentos da pasta .rules...\n', 'yellow');

  // Validar OPENAI_API_KEY obrigatória
  if (!OPENAI_API_KEY) {
    log('✗ Erro: OPENAI_API_KEY não configurada!', 'red');
    log('\nConfigure a variável de ambiente OPENAI_API_KEY:', 'yellow');
    log('  export OPENAI_API_KEY="sua-chave-aqui"\n', 'cyan');
    process.exit(1);
  }

  log(`Processando blocos com ${colors.yellow}##${colors.reset}`, 'reset');

  if (!fs.existsSync(RULES_DIR)) {
    log(`✗ Pasta .rules não encontrada: ${RULES_DIR}`, 'red');
    process.exit(1);
  }

  const collectionId = await getOrCreateCollection();

  // Ler todos os arquivos .md
  const files = fs.readdirSync(RULES_DIR).filter(f => f.endsWith('.md'));

  if (files.length === 0) {
    log('⚠️  Nenhum arquivo .md encontrado', 'yellow');
    return;
  }

  const allBlocks = [];

  for (const filename of files) {
    const filepath = path.join(RULES_DIR, filename);
    const relativePath = path.join('.rules', filename); // Caminho relativo ao projeto
    const content = fs.readFileSync(filepath, 'utf-8');
    const blocks = extractBlocks(content, filename, relativePath);
    allBlocks.push(...blocks);
  }

  log(`✓ ${allBlocks.length} blocos extraídos de ${files.length} arquivos`, 'green');

  if (allBlocks.length === 0) {
    log('✗ Nenhum bloco encontrado para indexar.', 'red');
    return;
  }

  // Validar tamanho de todos os blocos ANTES de gerar embeddings
  log(`Validando tamanho dos blocos...`, 'yellow');
  const oversizedBlocks = [];

  for (const block of allBlocks) {
    const validation = validateTextSize(block.document, block.metadata);
    if (!validation.valid) {
      oversizedBlocks.push(validation);
    }
  }

  // Se encontrou blocos muito grandes, parar e reportar
  if (oversizedBlocks.length > 0) {
    log('\n════════════════════════════════════════════════════════════════', 'red');
    log('✗ ERRO: Blocos excedem o limite de tamanho!', 'red');
    log('════════════════════════════════════════════════════════════════', 'red');
    log(`\n${colors.yellow}Limite máximo:${colors.reset} 32000 caracteres (~8000 tokens)`, 'reset');
    log(`${colors.yellow}Blocos com problema:${colors.reset} ${oversizedBlocks.length}`, 'reset');
    log('');

    for (let i = 0; i < oversizedBlocks.length; i++) {
      const block = oversizedBlocks[i];
      const meta = block.metadata;

      log(`\n${colors.red}Bloco #${i + 1}:${colors.reset}`, 'reset');
      log(`  ${colors.yellow}Arquivo:${colors.reset} ${meta.filepath}`);
      log(`  ${colors.yellow}Seção:${colors.reset} ${meta.header}`);
      log(`  ${colors.yellow}Linhas:${colors.reset} ${meta.start_line}-${meta.end_line} (${meta.end_line - meta.start_line + 1} linhas)`);
      log(`  ${colors.yellow}Tamanho:${colors.reset} ${block.size.toLocaleString()} caracteres`);
      log(`  ${colors.yellow}Excedeu:${colors.reset} ${colors.red}${block.exceeded.toLocaleString()} caracteres${colors.reset}`);
      log(`  ${colors.yellow}Título:${colors.reset} ${meta.title || '(sem título)'}`);
    }

    log('\n════════════════════════════════════════════════════════════════', 'red');
    log('💡 SOLUÇÃO:', 'yellow');
    log('════════════════════════════════════════════════════════════════', 'red');
    log('\nDivida a seção grande em MÚLTIPLOS BLOCOS ## com contextos específicos.');
    log('Cada bloco ## representa um chunk para embeddings semânticos.\n');
    log('Exemplo:', 'cyan');
    log('  ❌ Em vez de um único bloco grande:', 'reset');
    log('  ## [Implementação Passo a Passo]() - 36000 caracteres', 'yellow');
    log('');
    log('  ✅ Divida em múltiplos blocos ## específicos:', 'reset');
    log('  ## [Passo 1: Definir Interfaces do Use-Case]() - 8000 caracteres', 'green');
    log('  ## [Passo 2: Criar Classe Use-Case]() - 7000 caracteres', 'green');
    log('  ## [Passo 3: Registrar Use-Case no Module]() - 5000 caracteres', 'green');
    log('  ## [Passo 4: Injetar Use-Case via Dependency Injection]() - 6000 caracteres', 'green');
    log('  ## [Exemplo Completo: Use-Case Financeiro]() - 10000 caracteres', 'green');
    log('');
    log('Cada bloco ## deve:', 'cyan');
    log('  • Ter um título específico e descritivo');
    log('  • Representar um contexto único e bem delimitado');
    log('  • Ter idealmente < 30000 caracteres');
    log('  • Ser pesquisável independentemente nos embeddings');
    log('');

    process.exit(1);
  }

  log(`✓ Todos os blocos estão dentro do limite`, 'green');
  log(`Gerando embeddings via OpenAI...`, 'yellow');

  // Preparar dados para o ChromaDB
  const ids = allBlocks.map(b => b.id);
  const documents = allBlocks.map(b => b.document);
  const metadatas = allBlocks.map(b => b.metadata);

  // Gerar embeddings em lote via OpenAI (batch size máximo para minimizar chamadas)
  const embeddings = await generateEmbeddingsBatch(documents, 100);

  log(`Salvando no ChromaDB...`, 'yellow');

  // Adicionar ao ChromaDB
  const { ok, data } = await chromaFetch(`${API_BASE}/collections/${collectionId}/upsert`, {
    method: 'POST',
    body: JSON.stringify({ ids, documents, metadatas, embeddings })
  });

  if (ok) {
    log(`✓ ${allBlocks.length} blocos indexados com sucesso!`, 'green');

    // Mostrar resumo da coleção
    await showCollectionSummary(collectionId);
  } else {
    log(`✗ Erro ao indexar: ${JSON.stringify(data)}`, 'red');
    process.exit(1);
  }
}

// Função para mostrar resumo da coleção
async function showCollectionSummary(collectionId) {
  log('\n════════════════════════════════════════════════════════════════', 'blue');
  log('📊 RESUMO DA COLEÇÃO', 'yellow');
  log('════════════════════════════════════════════════════════════════', 'blue');

  try {
    // Obter todos os metadados da coleção
    const { ok: queryOk, data: queryData } = await chromaFetch(`${API_BASE}/collections/${collectionId}/get`, {
      method: 'POST',
      body: JSON.stringify({
        include: ['metadatas']
      })
    });

    if (!queryOk || !queryData.metadatas) {
      log('✗ Erro ao obter dados da coleção', 'red');
      return;
    }

    const totalDocs = queryData.metadatas.length;

    log(`\n${colors.yellow}Nome da Coleção:${colors.reset} rules_documentation`);
    log(`${colors.yellow}ID da Coleção:${colors.reset} ${collectionId}`);
    log(`${colors.yellow}Total de Documentos:${colors.reset} ${totalDocs}`);
    log(`${colors.yellow}Descrição:${colors.reset} Documentação de regras do projeto SDD`);

    if (queryData.metadatas && totalDocs > 0) {
      const fileStats = {};

      queryData.metadatas.forEach(meta => {
        const filename = meta.filename;
        if (!fileStats[filename]) {
          fileStats[filename] = {
            count: 0,
            filepath: meta.filepath
          };
        }
        fileStats[filename].count++;
      });

      log(`\n${colors.yellow}Arquivos Indexados:${colors.reset} ${Object.keys(fileStats).length}`);
      log('\n┌─────────────────────────────────────────────────────────────┬──────────┐');
      log('│ Arquivo                                                     │ Blocos   │');
      log('├─────────────────────────────────────────────────────────────┼──────────┤');

      const sortedFiles = Object.entries(fileStats).sort((a, b) => b[1].count - a[1].count);

      for (const [filename, stats] of sortedFiles) {
        const paddedFilename = filename.padEnd(59);
        const paddedCount = stats.count.toString().padStart(8);
        log(`│ ${paddedFilename} │ ${paddedCount} │`);
      }

      log('└─────────────────────────────────────────────────────────────┴──────────┘');

      // Estatísticas adicionais
      const totalBlocks = queryData.metadatas.length;
      const avgBlocksPerFile = (totalBlocks / Object.keys(fileStats).length).toFixed(1);

      log(`\n${colors.yellow}Estatísticas:${colors.reset}`);
      log(`  • Total de blocos indexados: ${colors.green}${totalBlocks}${colors.reset}`);
      log(`  • Média de blocos por arquivo: ${colors.green}${avgBlocksPerFile}${colors.reset}`);
      log(`  • Maior arquivo: ${colors.green}${sortedFiles[0][0]}${colors.reset} (${sortedFiles[0][1].count} blocos)`);
      log(`  • Menor arquivo: ${colors.green}${sortedFiles[sortedFiles.length - 1][0]}${colors.reset} (${sortedFiles[sortedFiles.length - 1][1].count} blocos)`);
    }

    log(`\n${colors.yellow}ChromaDB Host:${colors.reset} ${CHROMA_HOST}`);
    log(`${colors.yellow}Tenant:${colors.reset} ${TENANT}`);
    log(`${colors.yellow}Database:${colors.reset} ${DATABASE}`);
    log(`${colors.yellow}Modelo de Embedding:${colors.reset} ${OPENAI_API_KEY ? 'text-embedding-ada-002 (OpenAI)' : 'Simple Embedding (fallback)'}`);

    log('\n════════════════════════════════════════════════════════════════', 'blue');
    log('✓ Indexação concluída com sucesso!', 'green');
    log('════════════════════════════════════════════════════════════════\n', 'blue');

  } catch (error) {
    log(`\n✗ Erro ao gerar resumo: ${error.message}`, 'red');
  }
}

// Função para buscar documentos
async function queryDocuments(queryText, nResults = 5) {
  if (!queryText) {
    log('✗ Erro: Forneça um texto para busca.', 'red');
    log('Uso: docs query "como criar uma api backend"');
    process.exit(1);
  }

  // Validar OPENAI_API_KEY obrigatória
  if (!OPENAI_API_KEY) {
    log('✗ Erro: OPENAI_API_KEY não configurada!', 'red');
    log('\nConfigure a variável de ambiente OPENAI_API_KEY:', 'yellow');
    log('  export OPENAI_API_KEY="sua-chave-aqui"\n', 'cyan');
    process.exit(1);
  }

  log(`Buscando por: "${queryText}"\n`, 'yellow');

  // Obter coleção
  const collectionId = await getCollectionId();

  if (!collectionId) {
    log('✗ Coleção não encontrada. Execute primeiro: docs index', 'red');
    process.exit(1);
  }

  // Gerar embedding para o query
  const queryEmbedding = await generateEmbedding(queryText);

  // Fazer busca
  const { ok, data } = await chromaFetch(`${API_BASE}/collections/${collectionId}/query`, {
    method: 'POST',
    body: JSON.stringify({
      query_embeddings: [queryEmbedding],
      n_results: nResults,
      include: ['documents', 'metadatas', 'distances']
    })
  });

  if (!ok) {
    log(`✗ Erro ao buscar: ${JSON.stringify(data)}`, 'red');
    process.exit(1);
  }

  const results = data.documents[0];

  if (results.length === 0) {
    log('✗ Nenhum resultado encontrado.', 'red');
    return;
  }

  log(`✓ Encontrados ${results.length} resultados\n`, 'green');

  // Exibir resultados
  for (let i = 0; i < results.length; i++) {
    const doc = results[i];
    const metadata = data.metadatas[0][i];
    const distance = data.distances[0][i];
    const score = (1 - distance).toFixed(3);
    const scorePercent = (parseFloat(score) * 100).toFixed(1);

    // Definir cor do score baseado na relevância
    let scoreColor = 'green';
    if (scorePercent < 50) scoreColor = 'red';
    else if (scorePercent < 70) scoreColor = 'yellow';

    log('════════════════════════════════════════════════════════════════', 'blue');
    log(`Resultado #${i + 1}`, 'green');
    log(`${colors.yellow}Score de Relevância:${colors.reset} ${colors[scoreColor]}${scorePercent}%${colors.reset} (${score})`);
    log(`${colors.yellow}Arquivo:${colors.reset} ${metadata.filename}`);
    log(`${colors.yellow}Caminho:${colors.reset} ${metadata.filepath}`);

    // Exibir título se existir
    if (metadata.title && metadata.title.trim()) {
      log(`${colors.yellow}Título:${colors.reset} ${colors.cyan}${metadata.title}${colors.reset}`);
    }

    log(`${colors.yellow}Seção:${colors.reset} ${metadata.header}`);
    log(`${colors.yellow}Linhas:${colors.reset} ${metadata.start_line}-${metadata.end_line}`);
    log('\n' + colors.yellow + 'Conteúdo:' + colors.reset);
    log('────────────────────────────────────────────────────────────────', 'blue');

    // Exibir conteúdo completo
    console.log(doc);
    console.log('');
  }
}

// Função para buscar e retornar dados estruturados (para MCP)
async function queryDocumentsStructured(queryText, nResults = 5) {
  if (!queryText) {
    throw new Error('Texto de busca não fornecido');
  }

  if (!OPENAI_API_KEY) {
    throw new Error('OPENAI_API_KEY não configurada. Configure a variável de ambiente OPENAI_API_KEY.');
  }

  // Obter coleção
  const collectionId = await getCollectionId();

  if (!collectionId) {
    throw new Error('Coleção "rules_documentation" não encontrada. Execute primeiro: scripts/docs index');
  }

  // Gerar embedding para o query
  const queryEmbedding = await generateEmbedding(queryText);

  // Fazer busca
  const { ok, data } = await chromaFetch(`${API_BASE}/collections/${collectionId}/query`, {
    method: 'POST',
    body: JSON.stringify({
      query_embeddings: [queryEmbedding],
      n_results: nResults,
      include: ['documents', 'metadatas', 'distances']
    })
  });

  if (!ok) {
    throw new Error(`Erro ao buscar no ChromaDB: ${JSON.stringify(data)}`);
  }

  const results = data.documents[0];
  const metadatas = data.metadatas[0];
  const distances = data.distances[0];

  if (results.length === 0) {
    return {
      success: true,
      message: 'Nenhum resultado encontrado.',
      results: []
    };
  }

  // Formatar resultados
  const formattedResults = results.map((doc, i) => {
    const metadata = metadatas[i];
    const distance = distances[i];
    const score = (1 - distance);
    const scorePercent = (score * 100);

    return {
      rank: i + 1,
      score: score.toFixed(3),
      scorePercent: scorePercent.toFixed(1) + '%',
      filename: metadata.filename,
      filepath: metadata.filepath,
      title: metadata.title || null,
      section: metadata.header,
      lines: `${metadata.start_line}-${metadata.end_line}`,
      content: doc
    };
  });

  return {
    success: true,
    message: `Encontrados ${results.length} resultados`,
    query: queryText,
    totalResults: results.length,
    results: formattedResults
  };
}

// ============================================================================
// MCP SERVER IMPLEMENTATION
// ============================================================================

/**
 * Obtém informações da coleção do ChromaDB
 */
async function getCollectionInfo() {
  const collectionId = await getCollectionId();

  if (!collectionId) {
    return {
      exists: false,
      message: 'Coleção "rules_documentation" não encontrada. Execute: scripts/docs index'
    };
  }

  const { ok, data } = await chromaFetch(`${API_BASE}/collections/${collectionId}/get`, {
    method: 'POST',
    body: JSON.stringify({
      include: ['metadatas']
    })
  });

  if (!ok || !data.metadatas) {
    return {
      exists: true,
      error: 'Erro ao obter dados da coleção'
    };
  }

  const totalDocs = data.metadatas.length;
  const fileStats = {};

  data.metadatas.forEach(meta => {
    const filename = meta.filename;
    if (!fileStats[filename]) {
      fileStats[filename] = {
        count: 0,
        filepath: meta.filepath,
        sections: []
      };
    }
    fileStats[filename].count++;
    fileStats[filename].sections.push({
      header: meta.header,
      title: meta.title || null,
      lines: `${meta.start_line}-${meta.end_line}`
    });
  });

  return {
    exists: true,
    collectionId,
    collectionName: COLLECTION_NAME,
    totalDocuments: totalDocs,
    totalFiles: Object.keys(fileStats).length,
    files: fileStats,
    chromaHost: CHROMA_HOST,
    tenant: TENANT,
    database: DATABASE,
    embeddingModel: OPENAI_API_KEY ? 'text-embedding-ada-002 (OpenAI)' : 'Not configured'
  };
}

/**
 * Lista todos os arquivos de documentação disponíveis
 */
async function listDocsFiles() {
  if (!fs.existsSync(RULES_DIR)) {
    return [];
  }

  const files = fs.readdirSync(RULES_DIR)
    .filter(f => f.endsWith('.md'))
    .map(filename => {
      const filepath = path.join(RULES_DIR, filename);
      const stats = fs.statSync(filepath);
      return {
        filename,
        filepath,
        uri: `docs://files/${filename}`,
        size: stats.size,
        modified: stats.mtime.toISOString()
      };
    });

  return files;
}

/**
 * Lê o conteúdo completo de um arquivo de documentação
 */
function readDocsFile(filename) {
  const filepath = path.join(RULES_DIR, filename);

  if (!fs.existsSync(filepath)) {
    throw new Error(`Arquivo não encontrado: ${filename}`);
  }

  const content = fs.readFileSync(filepath, 'utf-8');
  return content;
}

/**
 * Gera um índice/sumário de todas as documentações
 */
function generateDocsIndex() {
  if (!fs.existsSync(RULES_DIR)) {
    return 'Pasta .rules não encontrada';
  }

  const files = fs.readdirSync(RULES_DIR).filter(f => f.endsWith('.md'));

  let index = '# Índice de Documentações e Regras Técnicas\n\n';

  files.forEach(filename => {
    const filepath = path.join(RULES_DIR, filename);
    const content = fs.readFileSync(filepath, 'utf-8');

    // Extrair título principal (primeiro # do arquivo)
    const titleMatch = content.match(/^#\s+\[(.+?)\]\(\)/m);
    const title = titleMatch ? titleMatch[1] : filename.replace('.md', '');

    index += `## ${title}\n`;
    index += `**Arquivo:** ${filename}\n`;
    index += `**URI:** docs://files/${filename}\n\n`;

    // Extrair seções ## do arquivo
    const sections = content.match(/^##\s+\[(.+?)\]\(\)/gm);
    if (sections && sections.length > 0) {
      index += '**Seções:**\n';
      sections.forEach(section => {
        const sectionTitle = section.match(/##\s+\[(.+?)\]\(\)/)[1];
        index += `- ${sectionTitle}\n`;
      });
      index += '\n';
    }
  });

  return index;
}

async function startMCPServer() {
  const readline = require('readline');

  const tools = [
    {
      name: 'search_project_docs',
      description: 'Busca semântica na documentação do projeto SDD (pasta .rules). Usa embeddings OpenAI para encontrar conteúdo relevante baseado em similaridade semântica.',
      inputSchema: {
        type: 'object',
        properties: {
          query: {
            type: 'string',
            description: 'Texto para busca semântica na documentação (ex: "como criar uma API", "padrões de use-case", "testes unitários")'
          },
          limit: {
            type: 'number',
            description: 'Número máximo de resultados a retornar (padrão: 5, máximo: 20)',
            default: 5
          }
        },
        required: ['query']
      }
    }
  ];

  // Gerar resources dinamicamente baseado nos arquivos .md disponíveis
  const docsFiles = await listDocsFiles();

  const resources = [
    {
      uri: 'docs://index',
      name: 'Índice de Documentações',
      description: 'Índice completo de todas as documentações e regras técnicas do projeto com sumário de seções',
      mimeType: 'text/markdown'
    }
  ];

  // Adicionar cada arquivo de documentação como um resource
  docsFiles.forEach(file => {
    resources.push({
      uri: file.uri,
      name: `Documentação: ${file.filename}`,
      description: `Conteúdo completo do arquivo ${file.filename} com regras técnicas e padrões do projeto`,
      mimeType: 'text/markdown'
    });
  });

  async function handleToolCall(name, args) {
    if (name === 'search_project_docs') {
      const limit = Math.min(args.limit || 5, 20);
      return await queryDocumentsStructured(args.query, limit);
    }
    throw new Error(`Ferramenta desconhecida: ${name}`);
  }

  async function handleResourceRead(uri) {
    // Índice de documentações
    if (uri === 'docs://index') {
      const index = generateDocsIndex();
      return {
        uri,
        mimeType: 'text/markdown',
        text: index
      };
    }

    // Arquivos individuais de documentação
    if (uri.startsWith('docs://files/')) {
      const filename = uri.replace('docs://files/', '');
      const content = readDocsFile(filename);
      return {
        uri,
        mimeType: 'text/markdown',
        text: content
      };
    }

    throw new Error(`Resource não encontrado: ${uri}`);
  }

  async function handleMessage(message) {
    const { method, params, id } = message;

    try {
      if (method === 'initialize') {
        return {
          jsonrpc: '2.0',
          id,
          result: {
            protocolVersion: '2024-11-05',
            serverInfo: {
              name: 'docs-search-server',
              version: '1.0.0'
            },
            capabilities: {
              tools: {},
              resources: {}
            }
          }
        };
      }

      if (method === 'notifications/initialized') {
        // Notification - não precisa de resposta
        console.error('✓ Cliente confirmou inicialização');
        return null;
      }

      if (method === 'tools/list') {
        return {
          jsonrpc: '2.0',
          id,
          result: {
            tools: tools
          }
        };
      }

      if (method === 'tools/call') {
        const { name, arguments: args } = params;
        const result = await handleToolCall(name, args);

        return {
          jsonrpc: '2.0',
          id,
          result: {
            content: [
              {
                type: 'text',
                text: JSON.stringify(result, null, 2)
              }
            ]
          }
        };
      }

      if (method === 'resources/list') {
        return {
          jsonrpc: '2.0',
          id,
          result: {
            resources: resources
          }
        };
      }

      if (method === 'resources/read') {
        const { uri } = params;
        const resource = await handleResourceRead(uri);

        return {
          jsonrpc: '2.0',
          id,
          result: {
            contents: [resource]
          }
        };
      }

      throw new Error(`Método não suportado: ${method}`);
    } catch (error) {
      return {
        jsonrpc: '2.0',
        id,
        error: {
          code: -32603,
          message: error.message
        }
      };
    }
  }

  // Log inicial para stderr (não interfere com o protocolo MCP)
  console.error('MCP Docs Search Server iniciado');
  console.error(`ChromaDB Host: ${CHROMA_HOST}`);
  console.error(`OpenAI API Key: ${OPENAI_API_KEY ? 'Configurada' : 'NÃO CONFIGURADA'}`);

  // Testar conexão com ChromaDB
  try {
    await chromaFetch(`${API_BASE}/collections`);
    console.error('✓ ChromaDB conectado com sucesso');
  } catch (error) {
    console.error(`✗ ERRO: Falha ao conectar com ChromaDB: ${error.message}`);
    process.exit(1);
  }

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: false
  });

  rl.on('line', async (line) => {
    try {
      const message = JSON.parse(line);
      const response = await handleMessage(message);
      // Só envia resposta se não for null (notifications não têm resposta)
      if (response !== null) {
        console.log(JSON.stringify(response));
      }
    } catch (error) {
      console.error(JSON.stringify({
        jsonrpc: '2.0',
        id: null,
        error: {
          code: -32700,
          message: `Parse error: ${error.message}`
        }
      }));
    }
  });

  rl.on('close', () => {
    console.error('MCP Server encerrado');
    process.exit(0);
  });
}

// Função principal
async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  try {
    if (command === 'index') {
      log('📚 Iniciando indexação de documentos...\n', 'blue');
      await indexDocuments();
    } else if (command === 'query') {
      const queryText = args.slice(1).join(' ');
      await queryDocuments(queryText);
    } else if (command === 'mcp') {
      await startMCPServer();
    } else {
      console.log('Uso:');
      console.log('  docs index                          # Indexa todos os documentos da pasta .rules');
      console.log('  docs query "texto de busca"         # Busca semântica nos documentos');
      console.log('  docs mcp                            # Inicia servidor MCP para integração com Claude Code');
      console.log('');
      console.log('Exemplos:');
      console.log('  docs index                          # Divide por títulos ## [texto]()');
      console.log('  docs query "como criar api"         # Busca semanticamente');
      console.log('  docs mcp                            # Modo servidor MCP');
      console.log('');
      console.log('Variáveis de ambiente:');
      console.log('  OPENAI_API_KEY                      # Chave da API OpenAI (OBRIGATÓRIA)');
      console.log('  CHROMA_HOST                         # Host do ChromaDB (padrão: http://localhost:8000)');
      console.log('');
      console.log('Nota: Este script requer a OPENAI_API_KEY configurada para gerar embeddings semânticos.');
      process.exit(1);
    }
  } catch (error) {
    log(`✗ Erro: ${error.message}`, 'red');
    process.exit(1);
  }
}

main();
