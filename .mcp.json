{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5432/postgres"
      ],
      "env": {
      }
    },
    "redis": {
      "type": "stdio",
      "command": "npx",
      "args": ["@liangshanli/mcp-server-redis"],
      "env": {
        "HOST": "localhost",
        "PORT": "6379"
      }
    },
    "docs-search": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/docs", "mcp"],
      "env": {
        "CHROMA_HOST": "http://localhost:8000"
      }
    },
    "mcp-start": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/mcp", "start"],
      "env": {}
    },
    "mcp-stop": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/mcp", "stop"],
      "env": {}
    },
    "mcp-migration": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/mcp", "migration"],
      "env": {}
    }
  }
}